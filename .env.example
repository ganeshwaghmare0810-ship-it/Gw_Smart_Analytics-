# Copy this file to .env and replace the placeholder with a Google App Password.
# Never use your normal Gmail password or commit the completed .env file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=gwsmartanalytics0810@gmail.com
SMTP_PASSWORD=replace_with_google_app_password
SMTP_FROM_NAME=GW Smart Analytics

# Use a long random value in production. Keep the same value across restarts.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Set to 1 only when the website is served through HTTPS.
GW_COOKIE_SECURE=0
GW_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:8501,http://localhost:8501

# Legacy subscription plan settings; dashboard/report pricing is fixed server-side at INR 10.
GW_PLAN_PRICE=10.0
GW_PLAN_VALIDITY_DAYS=30
GW_MAX_UPLOAD_MB=50

# Cashfree PG. Use sandbox credentials for local testing.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
GW_PUBLIC_BASE_URL=http://127.0.0.1:5000
# Email of an existing trusted account to promote to administrator at startup.
GW_ADMIN_EMAIL=

# Enter the special code only in the private .env file; never place it in frontend files.
GW_SPECIAL_ACCESS_CODE=

# Optional legacy Razorpay checkout; independent of the dashboard payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional absolute path outside the public application directory.
# GW_UPLOAD_DIR=C:\GW-Smart-Analytics-Private-Uploads
